{
  "Urls": "http://localhost:8275",
  "ConnectionStrings": {
    "TaskForge": "Data Source=data/taskforge.db"
  },
  "Worker": {
    "Count": 1,
    "PollIntervalMilliseconds": 500,
    "RetryDelaySeconds": 5,
    "LeaseGraceSeconds": 30
  },
  "HttpRequestJobs": {
    "AllowedHosts": [
      "localhost",
      "127.0.0.1"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
